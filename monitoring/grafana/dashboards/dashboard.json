{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],

  "title": "LedgerLens AI Monitoring",

  "schemaVersion": 39,

  "version": 1,

  "refresh": "5s",

  "time": {
    "from": "now-1h",
    "to": "now"
  },

  "panels": [

    {
      "title": "Documents Processed",

      "type": "stat",

      "datasource": "${DS_PROMETHEUS}",

      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },

      "targets": [
        {
          "expr": "ledgerlens_documents_total",
          "refId": "A"
        }
      ]
    },


    {
      "title": "Pending Human Review",

      "type": "stat",

      "datasource": "${DS_PROMETHEUS}",

      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },

      "targets": [
        {
          "expr": "ledgerlens_review_total",
          "refId": "A"
        }
      ]
    },


    {
      "title": "Processing Latency",

      "type": "timeseries",

      "datasource": "${DS_PROMETHEUS}",

      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },

      "targets": [
        {
          "expr": "rate(ledgerlens_processing_seconds_sum[5m])",
          "refId": "A"
        }
      ]
    },


    {
      "title": "AI Cost Usage",

      "type": "stat",

      "datasource": "${DS_PROMETHEUS}",

      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },

      "targets": [
        {
          "expr": "ledgerlens_cost_total",
          "refId": "A"
        }
      ]
    },


    {
      "title": "Invoice Processing Rate",

      "type": "timeseries",

      "datasource": "${DS_PROMETHEUS}",

      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 6,
        "h": 8
      },

      "targets": [
        {
          "expr": "rate(ledgerlens_documents_total[5m])",
          "refId": "A"
        }
      ]
    }

  ]
}